{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' '*.{ts,mts,json,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' '*.{ts,mts,json,md}'",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@primer/octicons-react": "^19.32.0",
    "@primer/primitives": "^11.10.0",
    "@primer/react": "^38.35.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@clerk/testing": "^2.2.16",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
